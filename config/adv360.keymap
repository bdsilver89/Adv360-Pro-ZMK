#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define WIN 0
#define MAC 1
#define GAMING 2
#define GAMING_NUM 3
#define KEYPAD 4
#define FN 5
#define MOD 6

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      sk: sticky_key {
          compatible = "zmk,behavior-sticky-key";
          label = "STICKY_KEY";
          #binding-cells = <1>;
          release-after-ms = <2000>;
          quick-release;
          ignore-modifiers;
          bindings = <&kp>;
      };

      sl: sticky_layer {
          compatible = "zmk,behavior-sticky-key";
          label = "STICKY_LAYER";
          #binding-cells = <1>;
          release-after-ms = <2000>;
          bindings = <&mo>;
      };

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    win_layer {
      display-name = "Windows";
      bindings = <
        &kp EQUAL &kp N1      &kp N2     &kp N3     &kp N4      &kp N5 &tog KEYPAD                                                           &mo MOD  &kp N6 &kp N7      &kp N8     &kp N9     &kp N0      &kp MINUS
        &kp TAB   &kp Q       &kp W      &kp F      &kp P       &kp B  &tog MAC                                                              &none    &kp J  &kp L       &kp U      &kp Y      &kp SEMI    &kp BSLH
        &kp ESC   &hm LCTRL A &hm LGUI R &hm LALT S &hm LSHFT T &kp G  &sl FN          &sk LCTRL &sk LALT &sk RGUI  &sk RCTRL                &sl FN   &kp M  &hm RSHFT N &hm RALT E &hm RGUI I &hm RCTRL O &kp SQT
        &sk LSHFT &kp Z       &kp X      &kp C      &kp D       &kp V                            &kp HOME &kp PG_UP                                   &kp K  &kp H       &kp COMMA  &kp DOT    &kp FSLH    &sk RSHFT
        &sl FN    &kp GRAVE   &kp CAPS   &kp LEFT   &kp RIGHT                 &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE                      &kp UP      &kp DOWN   &kp LBKT   &kp RBKT    &sl FN
      >;
    };

    mac_layer {
      display-name = "MacOS";
      bindings = <
        &kp EQUAL &kp N1      &kp N2      &kp N3     &kp N4      &kp N5 &tog KEYPAD                                                           &mo MOD  &kp N6 &kp N7      &kp N8     &kp N9      &kp N0      &kp MINUS
        &kp TAB   &kp Q       &kp W       &kp F      &kp P       &kp B  &tog MAC                                                              &none    &kp J  &kp L       &kp U      &kp Y       &kp SEMI    &kp BSLH
        &kp ESC   &hm LGUI A  &hm LCTRL R &hm LALT S &hm LSHFT T &kp G  &sl FN          &sk LGUI  &sk LALT &sk RCTRL &sk RGUI                 &sl FN   &kp M  &hm RSHFT N &hm RALT E &hm RCTRL I &hm RGUI O  &kp SQT
        &sk LSHFT &kp Z       &kp X       &kp C      &kp D       &kp V                            &kp HOME &kp PG_UP                                   &kp K  &kp H       &kp COMMA  &kp DOT     &kp FSLH    &sk RSHFT
        &sl FN    &kp GRAVE   &kp CAPS    &kp LEFT   &kp RIGHT                 &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE                      &kp UP      &kp DOWN   &kp LBKT    &kp RBKT    &sl FN
      >;
    };

    gaming_layer {
      display-name = "Gaming";
      bindings = <
        &kp ESC   &kp N1    &kp N2   &kp N3          &kp N4  &kp N5 &tog KEYPAD                                                           &mo MOD   &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp TAB   &kp Q    &kp W           &kp E   &kp R  &kp T                                                                 &none     &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp CAPS  &kp LSHFT &kp A    &kp S           &kp D   &kp F  &kp G           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL                &none     &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp LCTRL &kp Z    &kp X           &kp C   &kp V                            &kp HOME &kp PG_UP                                    &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &kp LCTRL &kp GRAVE &kp LALT &mo GAMING_NUM  &kp B                 &kp SPACE &kp DEL  &kp END  &kp PG_DN &kp ENTER &kp BSPC                        &kp UP &kp DOWN  &kp LBKT &kp RBKT &none
      >;
    };

    gaming_num_layer {
      display-name = "GamingNum";
      bindings = <
        &trans &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &trans                                                           &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans                                                           &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans                        &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                                      &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans                               &trans &trans &trans &trans &trans
      >;
    };

    keypad_layer {
      display-name = "Keypad";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo MOD &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp F    &kp P      &kp B  &none                                                            &none   &kp J  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp R    &kp S    &kp T      &kp G  &none           &sk LCTRL &sk LALT &sk LGUI  &sk RCTRL            &none   &kp M  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &sk LSHFT &kp Z     &kp X    &kp C    &kp D      &kp V                            &kp HOME &kp PG_UP                              &kp K  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &sk RSHFT
        &sl FN    &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0                 &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &sl FN
      >;
    };

    fn_layer {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2    &kp F3    &kp F4   &kp F5   &kp F6    &tog KEYPAD                                                           &mo MOD &kp F7    &kp F8   &kp F9   &kp F10 &kp F11   &kp F12
        &trans &kp EXCL  &kp AT    &kp HASH &kp DLLR &kp PRCNT &none                                                                 &none   &kp EQUAL &kp N7   &kp N8   &kp N9  &kp MINUS &trans
        &trans &kp CARET &kp PIPE  &kp LBRC &kp LPAR &kp LBKT  &none         &trans &trans &trans &trans                             &none   &trans    &kp N4   &kp N5   &kp N6  &kp PLUS  &trans
        &trans &kp AMPS  &kp ASTRK &kp RBRC &kp RPAR &kp RBKT                       &trans &trans                                            &trans    &kp N1   &kp N2   &kp N3  &kp UNDER &trans
        &trans &trans    &trans    &trans   &trans                    &trans &trans &trans &trans &trans &kp N0                                       &trans   &trans   &kp DOT &trans    &trans
      >;
    };

    mod_layer {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                                     &trans                 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none
        &none &kp C_STOP   &kp C_PP     &kp C_PREV   &kp C_NEXT   &none        &bootloader                                                                               &bootloader            &none        &none        &none        &none        &none        &none
        &studio_unlock &none &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &none        &rgb_ug RGB_MEFS_CMD 5  &bt BT_CLR &bt BT_CLR &bt BT_CLR &bt BT_CLR                        &rgb_ug RGB_MEFS_CMD 5 &none        &none        &none        &none        &none        &stp STP_BAT
        &none &none        &none        &kp C_BRI_DN &kp C_BRI_UP &macro_ver                                      &none      &none                                                              &tog GAMING  &none        &none        &none        &none        &none
        &none &none        &none        &bl BL_DEC   &bl BL_INC                               &rgb_ug RGB_TOG &bl BL_TOG &none      &none      &bl BL_TOG &rgb_ug RGB_TOG                                    &bl BL_INC   &bl BL_DEC   &none        &none        &none
      >;
    };
  };
};
